<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ViewWork.Views"
             x:Class="ViewWork.Views.HomeworkDialogView"
             x:DataType="views:HomeworkDialogModel"
             Width="380">
    <StackPanel Spacing="8">
        <TextBlock Text="学科"/>
        <ComboBox ItemsSource="{Binding Subjects}"
                  SelectedItem="{Binding Subject}"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="选择学科">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="作业内容" Margin="0,8,0,0"/>
        <TextBox Text="{Binding Text}"
                 Watermark="输入作业内容"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="96"/>
    </StackPanel>
</UserControl>
